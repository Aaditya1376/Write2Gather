# Copy this file to .env and fill it in
PORT=4000
CLIENT_URL=http://localhost:5173
# For GitHub Pages, use CLIENT_URL=https://aaditya1376.github.io and CLIENT_BASE_PATH=/Write2Gather
CLIENT_BASE_PATH=
MONGODB_URI=mongodb://127.0.0.1:27017/draftroom

# Use long random strings. Generate one with:
#   node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"hex\"))"
ACCESS_SECRET=change-me-access-secret-at-least-32-chars
REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Optional password recovery email via Resend (https://resend.com/)
RESEND_API_KEY=
PASSWORD_RESET_FROM=

# Optional: AI assistant (any OpenAI-compatible API). Leave the key empty to disable it.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
